DEBUG=True
SECRET_KEY=change-me

# Database: leave DATABASE_ENGINE unset (or anything other than "postgres")
# to use SQLite with zero setup. Set to "postgres" once PostgreSQL is
# installed and the fields below are filled in.
DATABASE_ENGINE=
DATABASE_NAME=futsal_db
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Email (OTP delivery): leave EMAIL_BACKEND unset to print OTP emails to the
# console instead of actually sending them (good for local dev). Set to
# "smtp" once you have real credentials, e.g. a Gmail account with an
# App Password (not your normal password): https://myaccount.google.com/apppasswords
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
