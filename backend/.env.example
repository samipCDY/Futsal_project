DEBUG=True
SECRET_KEY=change-me

# Database: the Supabase Postgres database (Supabase dashboard -> Connect ->
# "Session pooler"). Leave DATABASE_ENGINE empty to fall back to SQLite, but
# logins and bookings need the Supabase database.
DATABASE_ENGINE=postgres
DATABASE_NAME=postgres
DATABASE_USER=postgres.oauxglvqzjjaaezqapkl
DATABASE_PASSWORD=
DATABASE_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DATABASE_PORT=5432

# Supabase project URL, used to verify app login tokens.
SUPABASE_URL=https://oauxglvqzjjaaezqapkl.supabase.co

# Supabase secret key (Dashboard -> Project Settings -> API Keys -> Secret
# keys). Only lets the admin panel show the private lalpurja photos.
SUPABASE_SECRET_KEY=

# Emails to admins (new grounds to approve) and owners (approved/rejected).
# Brevo SMTP; the password is the Brevo SMTP key. Empty = printed to console.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Futsal Finder <you@example.com>
BACKEND_URL=http://localhost:8000

# Inbox(es) for "new ground to approve" emails, comma separated. Empty =
# the emails of the admin panel logins.
ADMIN_NOTIFY_EMAILS=
